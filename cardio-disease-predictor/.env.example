# Pick one:
GOOGLE_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here

# Set active provider: "gemini" or "groq"
LLM_PROVIDER=groq

# Groq model (free, fast): llama-3.1-8b-instant or gemma2-9b-it
GROQ_MODEL=llama-3.1-8b-instant

# Gemini model (free): gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-flash
